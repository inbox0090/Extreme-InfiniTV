---
import { IconCheck, IconSparkles } from "@tabler/icons-svelte"

const plans = [
  {
    id: "basic",
    name: "Basic",
    description: "A focused setup for your everyday viewing.",
    features: ["Movies and series", "Live channel support", "Personal watchlist"],
  },
  {
    id: "standard",
    name: "Standard",
    description: "A balanced experience across your viewing devices.",
    features: ["Everything in Basic", "Programme guide support", "Continue watching"],
    featured: true,
  },
  {
    id: "premium",
    name: "Premium",
    description: "A complete home-theatre workflow for your library.",
    features: ["Everything in Standard", "Offline downloads", "Advanced playback controls"],
  },
]
---

<!--
  UI-only pricing surface. This project has no built-in billing API or payment
  endpoint, so no prices or payment URLs are fabricated. Each CTA deliberately
  keeps the existing /login subscription-onboarding route intact. Hosting apps
  may populate [data-plan-price] and replace [data-plan-action] links at runtime.
-->
<section id="subscription-plans" class="cinema-plans" aria-labelledby="plans-title">
  <header class="cinema-plans__head">
    <p class="cinema-plans__eyebrow"><IconSparkles aria-hidden="true" /> Membership</p>
    <h2 id="plans-title">Find your viewing rhythm.</h2>
    <p>Connect the subscription supplied by your provider and keep your viewing experience in one place.</p>
  </header>

  <div class="cinema-plans__grid">
    {plans.map((plan) => (
      <article class:list={["cinema-plan", plan.featured && "cinema-plan--featured"]} data-plan={plan.id}>
        {plan.featured && <span class="cinema-plan__badge">Most popular</span>}
        <h3>{plan.name}</h3>
        <p class="cinema-plan__description">{plan.description}</p>
        <p class="cinema-plan__price" data-plan-price>
          <span>Provider pricing</span>
          <small>varies by subscription</small>
        </p>
        <ul>
          {plan.features.map((feature) => (
            <li><IconCheck aria-hidden="true" stroke={2.2} /> <span>{feature}</span></li>
          ))}
        </ul>
        <a href="/login" data-plan-action={plan.id} class:list={[plan.featured ? "btn-primary" : "btn", "cinema-plan__action"]}>
          Choose plan
        </a>
      </article>
    ))}
  </div>
</section>
